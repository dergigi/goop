# Snaps built by snapcraft without Snap Store credentials are unsigned and
# cannot be installed without bypassing signature checks. Use:
#   sudo snap install --dangerous ./goop_<version>_<arch>.snap
# For signed installs (`snap install goop`), publish via the Snap Store.
name: goop
title: Goop
base: core24
version: "$RELEASE_VERSION"
summary: A native NIP-17 client for you and your agents.
description: |
  Chat freely without sharing phone numbers or emails.
  Your messages are encrypted, and your privacy stays protected.
  Just privacy, made simple - with Nostr.
grade: stable
confinement: classic
compression: lzo
website: https://github.com/dergigi/goop
source-code: https://github.com/dergigi/goop
issues: https://github.com/dergigi/goop/issues
contact: https://dergigi.com

parts:
  goop:
    plugin: dump
    source: target/release/goop-linux-$ARCH_SUFFIX.tar.gz

    organize:
      # These renames seem to not be necessary, but it's tidier.
      bin: usr/bin
      libexec: usr/libexec

    stage-packages:
      - libasound2t64
      # snapcraft has a lint that this is unused, but without it Goop exits with
      # "Missing Vulkan entry points: LibraryLoadFailure" in blade_graphics.
      - libvulkan1
      # snapcraft has a lint that this is unused, but without it Goop exits with
      # "NoWaylandLib" when run with Wayland.
      - libwayland-client0
      - libxcb1
      - libxkbcommon-x11-0
      - libxkbcommon0

    build-attributes:
      - enable-patchelf

    prime:
      # Omit unneeded files from the tarball
      - -lib
      - -licenses.md
      - -share

      # Omit unneeded files from stage-packages
      - -etc
      - -usr/share/doc
      - -usr/share/lintian
      - -usr/share/man

apps:
  goop:
    command: usr/bin/goop
    common-id: com.dergigi.goop
    environment:
      GOOP_BUNDLE_TYPE: snap
